# Outside source content is not kept in git: scripts/setup.py downloads it to download/
# and builds reference/BSB/, reference/MSB/ and orig/ from it (see docs/sources.md).
download/
# Tools cloned at a pinned tag (lexeme-aligner: GPL-3.0, its own repo), with their venvs
tools/
reference/BSB/
reference/MSB/
orig/

# The clause-overlay examples carry BHSA levels (CC BY-NC 4.0): never published
docs/clause-sidecar/examples/

# Imported editions are filed by licence (import/README.md): CC0/, CC-BY/ and CC-BY-SA/ are kept; non-free/, CC-ND/
# and CC-NC/ keep only their descriptions; any other folder stays out until it is added here.
import/*
!import/README.md
!import/_template/
!import/CC0/
!import/CC-BY/
!import/CC-BY-SA/
!import/non-free/
!import/CC-ND/
!import/CC-NC/
# non-free/, CC-ND/, CC-NC/: only each edition's description (edition.yaml, README.md) and our build scripts are kept;
# its texts (text/, source/, glossary, quarantined/) stay local
import/non-free/*/*/*
!import/non-free/*/*/edition.yaml
!import/non-free/*/*/README.md
!import/non-free/*/*/*.py
!import/non-free/*/*/.gitignore
!import/non-free/*/*/fetch.lock.json
import/CC-ND/*/*/*
!import/CC-ND/*/*/edition.yaml
!import/CC-ND/*/*/README.md
!import/CC-ND/*/*/*.py
!import/CC-ND/*/*/.gitignore
!import/CC-ND/*/*/fetch.lock.json
import/CC-NC/*/*/*
!import/CC-NC/*/*/edition.yaml
!import/CC-NC/*/*/README.md
!import/CC-NC/*/*/*.py
!import/CC-NC/*/*/.gitignore
!import/CC-NC/*/*/fetch.lock.json

# Derived work returned to a rights holder (docs/licensing.md, *Three output paths*): never in git
local_output/

# Drafts of chapters that a published translation already covers: kept locally, never in git
# a quarantine moves an edition's text aside (scripts/quarantine.py): the text never goes into git, in any licence folder
import/**/quarantined/
export/**/quarantine/
# Generated files that print corpus verses (docs/licensing.md): local only, rebuilt at will
export/**/_learn/packs/
export/**/_learn/links_*.tsv
export/**/_learn/units_*.tsv
export/**/_learn/derived_report.md
export/**/_learn/nt-only/
export/**/_learn/style_norms*.json
export/**/*_style.md
export/**/_eval/local/
export/**/wiki-view.html

# Local only (CLAUDE.local.md holds this working copy's private state)
CLAUDE.local.md
# the built website and the worktree of the `site` branch (scripts/build_site.py, scripts/deploy_site.py)
build/
.site/
.netlify/
scratch/
__pycache__/
.DS_Store
# the drafting agents' interim tagged files (scripts/full_align.py split makes the .txt and .align from them)
export/**/*.tagged
# the project's target-language database (scripts/lang.py): bulk, built locally from the imported edition
export/**/_learn/*.sqlite

# personal API keys (scripts/fetch_edition.py reads DBT_API_KEY from it); never in git
.env
.env.*
